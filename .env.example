# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Optional Gemini API Key for AI features.
# If omitted or failed, EventCraft AI automatically enters MOCK MODE with realistic fallback suggestions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

